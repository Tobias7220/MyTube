{
  "name": "mytube",
  "version": "0.1.0",
  "description": "MyTube Beta 0.4",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.mytube.app",
    "productName": "MyTube",
    "files": [
      "main.js",
      "preload.js",
      "core/**",
      "renderer/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "artifactName": "MyTube_Beta_0.4.${ext}"
  }
}